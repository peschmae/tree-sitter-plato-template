{
    "metadata": {
        "version": "0.19.5",
        "license": "MIT",
        "description": "Plato triple-brace Go template grammar for tree-sitter",
        "authors": [
            {
                "name": "Nikita Galaiko"
            }
        ],
        "links": {
            "repository": "https://github.com/ngalaiko/tree-sitter-go-template"
        }
    },
    "grammars": [
        {
            "name": "plato",
            "camelcase": "Plato",
            "scope": "source.plato",
            "path": ".",
            "file-types": ["plato"],
            "content-regex": "\\{\\{\\{.+\\}\\}\\}"
        }
    ],
    "bindings": {
        "c": true,
        "go": true,
        "node": true,
        "python": true,
        "rust": true,
        "swift": true
    }
}
